# Copy to .env.local for local development, and set the same names in the
# Vercel project settings for production. Never commit real values -
# .env.local and .env are gitignored; this example file is not.

# --- Required for lead capture -------------------------------------------
# MongoDB Atlas connection string. Atlas > Database > Connect > Drivers.
# Restrict the database user to readWrite on this database only.
MONGODB_URI=

# Optional. Defaults to good_looking_digital.
MONGODB_DB=good_looking_digital

# --- Required for notifications ------------------------------------------
# Resend API key (resend.com). Swapping providers means editing
# src/lib/notify.ts only - there is no vendor SDK in the dependency tree.
RESEND_API_KEY=

# Where new enquiries are sent. Falls back to site.email if unset.
LEAD_NOTIFICATION_EMAIL=

# Must be an address on a domain verified with the provider, or delivery
# will be rejected.
LEAD_FROM_EMAIL=Good Looking Digital <hello@goodlookingdigital.com>

# --- Optional: text yourself when a lead arrives -------------------------
# Twilio. Called over the REST API, so there is no SDK in the dependency
# tree and swapping providers means editing src/lib/notify.ts only.
#
# US business messaging also needs A2P 10DLC registration with the carrier,
# which Twilio walks you through. Without it, messages get filtered.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Your mobile, in E.164 format, e.g. +17085550142
# Only ever your own number. See the TCPA note in the README before you
# consider texting customers.
LEAD_SMS_TO=

# --- Required for follow-up reminders ------------------------------------
# Authorizes the reminder sweep at /api/cron/lead-reminders. Without it the
# endpoint returns 401 to everyone, which is the safe default: a public URL
# that emails people on demand is not something to leave open.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Signs the "already dealt with it?" link in a reminder email. Lead ids
# travel in email and are not secret, so the link carries an HMAC instead.
# Changing this invalidates every link already sent.
# Generate one with: openssl rand -hex 32
LEAD_ACTION_SECRET=

# Optional. Hours an enquiry may sit unanswered before it is chased.
# Defaults to 8 - long enough that a reminder means "this was missed"
# rather than "you are busy".
LEAD_REMINDER_AFTER_HOURS=8

# Optional. The zone the 8am-8pm sending window is measured in. Serverless
# runs in UTC, so this has to be stated rather than assumed.
LEAD_REMINDER_TIMEZONE=America/Chicago

# Optional. Where reminders go. Falls back to LEAD_NOTIFICATION_EMAIL.
LEAD_REMINDER_EMAIL=

# Optional. Absolute base URL used to build the link in a reminder email.
# Falls back to site.url.
NEXT_PUBLIC_SITE_URL=
