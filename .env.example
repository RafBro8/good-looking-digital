# Copy to .env.local for local development, and set the same names in the
# Vercel project settings for production. Never commit real values —
# .env.local and .env are gitignored; this example file is not.

# --- Required for lead capture -------------------------------------------
# MongoDB Atlas connection string. Atlas > Database > Connect > Drivers.
# Restrict the database user to readWrite on this database only.
MONGODB_URI=

# Optional. Defaults to good_looking_digital.
MONGODB_DB=good_looking_digital

# --- Required for notifications ------------------------------------------
# Resend API key (resend.com). Swapping providers means editing
# src/lib/notify.ts only — there is no vendor SDK in the dependency tree.
RESEND_API_KEY=

# Where new enquiries are sent. Falls back to site.email if unset.
LEAD_NOTIFICATION_EMAIL=

# Must be an address on a domain verified with the provider, or delivery
# will be rejected.
LEAD_FROM_EMAIL=Good Looking Digital <hello@goodlookingdigital.com>
